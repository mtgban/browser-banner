{
  "manifest_version": 3,
  "name": "BANner",
  "version": "0.2.0",
  "description": "Get a card store's lists to BAN: Cardmarket, Card Kingdom, TCGplayer, ManaPool and Star City Games.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "banner@mtgban.com",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.cardmarket.com/*/*/Users/*/Offers/*"
      ],
      "js": [
        "core/net.js",
        "core/csv.js",
        "sites/cardmarket/src/rates.js",
        "sites/cardmarket/src/parse.js",
        "sites/cardmarket/src/pages.js",
        "sites/cardmarket/src/csv.js",
        "core/ui.js",
        "sites/cardmarket/src/ui.js",
        "core/handoff.js",
        "sites/cardmarket/src/handoff.js",
        "sites/cardmarket/src/content.js"
      ],
      "css": [
        "core/panel.css",
        "sites/cardmarket/src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.cardmarket.com/*/*/Orders/*"
      ],
      "js": [
        "core/net.js",
        "core/csv.js",
        "sites/cardmarket/src/rates.js",
        "sites/cardmarket/src/parse.js",
        "sites/cardmarket/src/csv.js",
        "core/ui.js",
        "sites/cardmarket/src/ui.js",
        "core/handoff.js",
        "sites/cardmarket/src/handoff.js",
        "sites/cardmarket/src/orderpage.js"
      ],
      "css": [
        "core/panel.css",
        "sites/cardmarket/src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.cardmarket.com/*/*/Orders/Purchases/*"
      ],
      "js": [
        "core/net.js",
        "core/csv.js",
        "core/money.js",
        "core/ranges.js",
        "sites/cardmarket/src/rates.js",
        "sites/cardmarket/src/pages.js",
        "sites/cardmarket/src/history.js",
        "core/ui.js",
        "sites/cardmarket/src/ui.js",
        "sites/cardmarket/src/historypage.js"
      ],
      "css": [
        "core/panel.css",
        "sites/cardmarket/src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.cardkingdom.com/myaccount/order_history*",
        "https://www.cardkingdom.com/myaccount/selling_history*"
      ],
      "js": [
        "core/net.js",
        "core/csv.js",
        "core/money.js",
        "core/ranges.js",
        "sites/cardkingdom/src/net.js",
        "sites/cardkingdom/src/money.js",
        "sites/cardkingdom/src/csv.js",
        "core/ui.js",
        "sites/cardkingdom/src/ui.js",
        "sites/cardkingdom/src/store.js",
        "sites/cardkingdom/src/history.js",
        "sites/cardkingdom/src/historypage.js"
      ],
      "css": [
        "core/panel.css",
        "sites/cardkingdom/src/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.cardkingdom.com/sellcart*",
        "https://www.cardkingdom.com/cart*"
      ],
      "js": [
        "core/net.js",
        "core/csv.js",
        "core/money.js",
        "sites/cardkingdom/src/net.js",
        "sites/cardkingdom/src/money.js",
        "sites/cardkingdom/src/csv.js",
        "core/ui.js",
        "sites/cardkingdom/src/ui.js",
        "sites/cardkingdom/src/cart.js",
        "sites/cardkingdom/src/prices.js",
        "sites/cardkingdom/src/store.js",
        "sites/cardkingdom/src/compare.js",
        "sites/cardkingdom/src/update.js",
        "core/handoff.js",
        "sites/cardkingdom/src/handoff.js",
        "sites/cardkingdom/src/cartpage.js"
      ],
      "css": [
        "core/panel.css",
        "sites/cardkingdom/src/panel.css",
        "sites/cardkingdom/src/cart.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.cardkingdom.com/myaccount/po_invoice/*",
        "https://www.cardkingdom.com/myaccount/invoice/*"
      ],
      "js": [
        "core/net.js",
        "core/csv.js",
        "core/money.js",
        "sites/cardkingdom/src/net.js",
        "sites/cardkingdom/src/money.js",
        "sites/cardkingdom/src/csv.js",
        "core/ui.js",
        "sites/cardkingdom/src/ui.js",
        "sites/cardkingdom/src/prices.js",
        "sites/cardkingdom/src/store.js",
        "sites/cardkingdom/src/compare.js",
        "core/handoff.js",
        "sites/cardkingdom/src/handoff.js",
        "sites/cardkingdom/src/invoice.js",
        "sites/cardkingdom/src/invoicepage.js"
      ],
      "css": [
        "core/panel.css",
        "sites/cardkingdom/src/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.tcgplayer.com/*"
      ],
      "js": [
        "core/net.js",
        "core/csv.js",
        "core/money.js",
        "core/ranges.js",
        "sites/tcgplayer/src/money.js",
        "sites/tcgplayer/src/csv.js",
        "sites/tcgplayer/src/read.js",
        "sites/tcgplayer/src/net.js",
        "sites/tcgplayer/src/walk.js",
        "core/handoff.js",
        "sites/tcgplayer/src/handoff.js",
        "core/ui.js",
        "sites/tcgplayer/src/ui.js",
        "sites/tcgplayer/src/page.js"
      ],
      "css": [
        "core/panel.css",
        "sites/tcgplayer/src/orders.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://manapool.com/*"
      ],
      "js": [
        "core/net.js",
        "core/csv.js",
        "core/money.js",
        "core/ranges.js",
        "core/ui.js",
        "sites/manapool/src/ui.js",
        "sites/manapool/src/api.js",
        "sites/manapool/src/history.js",
        "sites/manapool/src/order.js",
        "core/handoff.js",
        "sites/manapool/src/handoff.js",
        "sites/manapool/src/cart.js",
        "sites/manapool/src/page.js"
      ],
      "css": [
        "core/panel.css",
        "sites/manapool/src/cart.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://starcitygames.com/account.php*"
      ],
      "js": [
        "core/net.js",
        "core/csv.js",
        "core/money.js",
        "core/ranges.js",
        "core/ui.js",
        "sites/starcitygames/src/ui.js",
        "sites/starcitygames/src/read.js",
        "sites/starcitygames/src/money.js",
        "sites/starcitygames/src/history.js",
        "sites/starcitygames/src/order.js",
        "core/handoff.js",
        "sites/starcitygames/src/handoff.js",
        "sites/starcitygames/src/page.js"
      ],
      "css": [
        "core/panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
